VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:5001
# Optional: public Mapbox token for the venue map (dark basemap, address
# search, reverse geocoding). Free account, no credit card — see
# docs-site/docs/third-party/mapbox.md. Leave empty to fall back to
# OpenStreetMap tiles with no address search.
VITE_MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN_HERE
