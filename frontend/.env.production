# Values baked into the production frontend build (vite build).
# Render appends a random suffix when the service name is taken, so this is
# the service's actual URL, not derived from its name.
# Clerk publishable keys are public by design — they ship in the JS bundle.
VITE_API_URL=https://kickstat-api-i2rc.onrender.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YWNlLWxvdXNlLTQ0LmNsZXJrLmFjY291bnRzLmRldiQ
# Mapbox public token for the venue map (public by design, same rule as the
# Clerk key above). Create a free account at mapbox.com, copy the default
# public token, and paste it here — until then the map silently falls back
# to OpenStreetMap tiles with no address search.
VITE_MAPBOX_TOKEN=pk.eyJ1IjoibmRvbmRvLTI3IiwiYSI6ImNtdW02enNkbTIybjEyeXBnMWg0ZWJ5dW0ifQ.Ka_x1_KU84NnO5afMw_Hag
