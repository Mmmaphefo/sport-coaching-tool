// Cloudflare Pages config for the Kickstat frontend.
// pages_build_output_dir makes `wrangler pages deploy` config-driven, so the
// project name comes from here rather than an interactive prompt.
// CI deploys on every push to main (see .gitea/workflows/ci.yml). To deploy
// by hand from the repo root: build the frontend (cd frontend && npm run build),
// then run: npx wrangler pages deploy --branch=main
// Wrangler 4 has no --force flag for pages deploy; branch "main" is the
// production branch, which serves kickstat.pages.dev.
{
  "name": "kickstat",
  "compatibility_date": "2026-09-14",
  "pages_build_output_dir": "frontend/dist"
}
